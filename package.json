{
  "name": "filefusion",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node tools/build-pages.ts && vite",
    "build": "node tools/build-pages.ts && npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json",
    "format": "prettier --write .",
    "banner": "node tools/banner.ts"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "playwright-core": "^1.48.2",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "@breezystack/lamejs": "^1.2.7",
    "fflate": "^0.8.3",
    "gifenc": "^1.0.3",
    "libheif-js": "^1.23.5",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.4.299"
  }
}
